{
	"name": "duc",
	"displayName": "Duc",
	"description": "View, Change and Preview .duc files",
	"version": "0.0.0-development",
	"publisher": "ducflair",
	"private": false,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ducflair/vscode-duc"
	},
	"homepage": "https://github.com/ducflair/vscode-duc/blob/main/README.md",
	"bugs": {
		"url": "https://github.com/ducflair/vscode-duc/issues"
	},
	"engines": {
		"vscode": "^1.99.0"
	},
	"categories": [
		"Other",
		"Formatters",
		"Visualization"
	],
	"keywords": [
		"duc",
		"sqlite",
		"database",
		"viewer",
		"preview",
		"CAD"
	],
	"icon": "media/icon.png",
	"galleryBanner": {
		"color": "#261C19",
		"theme": "dark"
	},
	"extensionDependencies": [
		"qwtel.sqlite-viewer"
	],
	"activationEvents": [
		"onCustomEditor:ducPreview.ducViewer"
	],
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "ducPreview.ducViewer",
				"displayName": "DUC Database Viewer",
				"selector": [
					{
						"filenamePattern": "*.duc"
					}
				],
				"priority": "default"
			}
		],
		"languages": [
			{
				"id": "duc",
				"aliases": [
					"DUC"
				],
				"extensions": [
					".duc"
				],
				"icon": {
					"light": "src/assets/duc.svg",
					"dark": "src/assets/duc.svg"
				}
			}
		],
		"configurationDefaults": {
			"workbench.editorAssociations": {
				"*.duc": "ducPreview.ducViewer"
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint . --config eslint.config.mjs",
		"watch": "tsc -w -p ./",
		"package": "vsce package",
		"publish": "vsce publish",
		"semantic-release": "npm run semantic-release"
	},
	"devDependencies": {
		"@eslint/js": "^9.26.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.0.3",
		"@semantic-release/github": "^11.0.2",
		"@semantic-release/npm": "^12.0.1",
		"@semantic-release/release-notes-generator": "^14.0.3",
		"@stylistic/eslint-plugin": "^4.2.0",
		"@types/node": "^22.15.17",
		"@types/vscode": "^1.99.0",
		"@vscode/vsce": "^3.3.2",
		"eslint": "^9.26.0",
		"semantic-release": "^24.2.3",
		"semantic-release-vsce": "^6.0.7",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.32.0"
	},
	"dependencies": {}
}